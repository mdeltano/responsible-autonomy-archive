# Responsible Autonomy configuration (spec Step 1). Copy to .env or export in your shell.
# Never commit a real credential. Values below are the validated defaults.

# Planner provider. Only "fake" (deterministic, offline) is implemented until Step 8.
MODEL_PROVIDER=fake
# Model ID; recorded in task and evaluation reports.
MODEL_ID=fake-model
# Provider credential placeholder. Required only for a real provider. Never logged or sent in prompts.
MODEL_API_KEY=
# SQLite database file (tasks, synthetic ledger, audit log). Created with restrictive permissions.
DATABASE_PATH=./data/responsible-autonomy.sqlite
# Per-task token cap. MUST be a positive integer before a real provider is enabled.
MAX_TOKENS_PER_TASK=
# Enables the developer-only evaluation command.
EVALUATION_ENABLED=false

# Versioned, operator-supplied refund policy.
POLICY_PATH=./policies/refund-policy.v1.json
# Configured three-letter uppercase currency code. No conversions are inferred.
CURRENCY=USD

# Local single-owner demo identity. DEMO ASSUMPTION: trusted caller context for a local demo, not
# production authentication. Roles are comma-separated, e.g. refund_approver.
LOCAL_OWNER_ID=local-owner
LOCAL_ACTOR_ID=local-operator
LOCAL_ROLES=

# Optional per-task cost cap in USD.
MAX_COST_USD_PER_TASK=
MAX_PLANNING_STEPS=15
MAX_TOOL_CALLS=20
MAX_QUESTIONS=3
MAX_PROVIDER_RETRIES=2
# Active execution clock; waiting for answers/approvals does not consume it.
ACTIVE_TIMEOUT_MS=120000
PENDING_TASK_TTL_MS=86400000
APPROVAL_TTL_MS=300000
MAX_ACTIVE_TASKS=2
MAX_QUEUED_TASKS=10
RETENTION_DAYS=7
# error | warn | info | debug. Diagnostics go to stderr.
LOG_LEVEL=info
# Log raw prompts and records. Off by default.
LOG_RAW_CONTENT=false
